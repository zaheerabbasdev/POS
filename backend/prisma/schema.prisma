// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// Mobile Shop POS System — Database Schema
// Source: req/POS Doc.docx — Volume 3, Database Design Document (DDD)
// Naming: PascalCase Prisma models / snake_case Postgres tables & columns
// Primary keys: UUID on every table (DDD Chapter 33 — Data Dictionary)
// =====================================================================

// ---------------------------------------------------------------------
// Enums
// Fixed value sets called out explicitly in the DDD table definitions.
// Stored as native Postgres enums instead of free-text VARCHAR for
// data integrity (BRD 17.x / SRS Chapter 12 business rules).
// ---------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ImeiStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  UNDER_REPAIR
  REPLACED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
  REPAIR
}

enum CustomerType {
  REGULAR
  WHOLESALE
  VIP
  CORPORATE
}

enum PurchasePaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentType {
  SALE_PAYMENT
  PURCHASE_PAYMENT
  REFUND
  SUPPLIER_REFUND
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  MOBILE_WALLET
  MIXED_PAYMENT
}

enum CashDrawerStatus {
  OPEN
  CLOSED
}

enum CashDrawerTransactionType {
  OPENING_BALANCE
  SALE
  REFUND
  EXPENSE
  CASH_IN
  CASH_OUT
  CLOSING_BALANCE
}

enum RepairStatus {
  RECEIVED
  UNDER_INSPECTION
  WAITING_FOR_PARTS
  IN_PROGRESS
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  NEW_SALE
  PURCHASE
  REPAIR
  WARRANTY
  PAYMENT
  SYSTEM
}

// =====================================================================
// Authentication & Authorization — DDD Chapter 17
// =====================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  username     String    @unique @db.VarChar(100)
  email        String?   @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  profileImage String?   @map("profile_image")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee?  @relation(fields: [employeeId], references: [id])
  roles    UserRole[]

  createdPurchases       Purchase[]             @relation("PurchaseCreatedBy")
  createdPurchaseReturns PurchaseReturn[]       @relation("PurchaseReturnCreatedBy")
  createdInventoryTx     InventoryTransaction[] @relation("InventoryTransactionCreatedBy")
  adjustedStock          StockAdjustment[]      @relation("StockAdjustmentAdjustedBy")
  cashierSales           Sale[]                 @relation("SaleCashier")
  approvedSalesReturns   SalesReturn[]          @relation("SalesReturnApprovedBy")
  receivedPayments       Payment[]              @relation("PaymentReceivedBy")
  cashierDrawers         CashDrawer[]           @relation("CashDrawerCashier")
  updatedSettings        Setting[]              @relation("SettingUpdatedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

/// Not in the original DDD — added to support the Forgot/Reset Password
/// APIs specified in the API Specification Document (Chapters 14–15).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  roleName    String   @unique @map("role_name") @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             String  @id @default(uuid()) @db.Uuid
  permissionName String  @unique @map("permission_name") @db.VarChar(150)
  module         String  @db.VarChar(100)
  description    String?

  roles RolePermission[]

  @@map("permissions")
}

/// Junction table — Users ↔ Roles (many-to-many)
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// Junction table — Roles ↔ Permissions (many-to-many)
model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =====================================================================
// Employee — DDD Chapter 18
// =====================================================================

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  employeeCode String         @unique @map("employee_code") @db.VarChar(30)
  firstName    String         @map("first_name") @db.VarChar(100)
  lastName     String?        @map("last_name") @db.VarChar(100)
  phone        String?        @unique @db.VarChar(20)
  email        String?        @db.VarChar(255)
  address      String?
  designation  String?        @db.VarChar(100)
  salary       Decimal?       @db.Decimal(12, 2)
  joiningDate  DateTime       @map("joining_date") @db.Date
  status       EmployeeStatus @default(ACTIVE)
  // Not in DDD Table 18 — API Spec Chapter 52's "Employee Photo" upload type
  // needs somewhere to land; User already has profileImage, but a technician
  // or other employee doesn't necessarily have a login, so it lives here too.
  profileImage String?        @map("profile_image")
  createdAt    DateTime       @default(now()) @map("created_at")

  user             User?
  repairsAssigned  Repair[]
  expensesRecorded Expense[]

  @@map("employees")
}

// =====================================================================
// Product Master Data — DDD Chapter 19
// =====================================================================

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  brandName   String   @unique @map("brand_name") @db.VarChar(100)
  description String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  productModels ProductModel[]
  products      Product[]

  @@map("brands")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  categoryName String   @unique @map("category_name") @db.VarChar(100)
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model ProductModel {
  id          String   @id @default(uuid()) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  modelName   String   @map("model_name") @db.VarChar(150)
  releaseYear Int?     @map("release_year")
  description String?
  // Not in DDD Table 9, but SRS Module 5 ("Models can be activated or
  // deactivated") and API Spec Chapter 25 (status filter) both require it.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  brand    Brand     @relation(fields: [brandId], references: [id])
  products Product[]

  @@unique([brandId, modelName])
  @@map("product_models")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String   @unique @db.VarChar(50)
  productName    String   @map("product_name") @db.VarChar(200)
  brandId        String?  @map("brand_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  productModelId String?  @map("product_model_id") @db.Uuid
  purchasePrice  Decimal  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(12, 2)
  wholesalePrice Decimal? @map("wholesale_price") @db.Decimal(12, 2)
  taxPercentage  Decimal  @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  warrantyMonths Int?     @map("warranty_months")
  barcode        String?  @unique @db.VarChar(100)
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  // Not in DDD Table 10 — SRS 17.2 requires "Mobile phones should be tracked
  // using IMEI numbers. Accessories should be managed by quantity." but the
  // DDD gives no structural way to tell which is which. Drives IMEI
  // validation in Purchases/Sales (Phase 4).
  tracksImei     Boolean  @default(false) @map("tracks_imei")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  brand        Brand?        @relation(fields: [brandId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  productModel ProductModel? @relation(fields: [productModelId], references: [id])

  images              ProductImage[]
  imeiNumbers         ImeiNumber[]
  inventory           Inventory?
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesReturnItems    SalesReturnItem[]
  repairs             Repair[]
  repairItems         RepairItem[]
  warranties          Warranty[]
  inventoryTx         InventoryTransaction[]
  stockAdjustments    StockAdjustment[]

  @@index([productName])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  publicId  String?  @map("public_id") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// Tracks every mobile phone unit individually via IMEI — SRS Module 7
model ImeiNumber {
  id            String     @id @default(uuid()) @db.Uuid
  productId     String     @map("product_id") @db.Uuid
  imeiNumber    String     @unique @map("imei_number") @db.VarChar(50)
  serialNumber  String?    @map("serial_number") @db.VarChar(100)
  purchaseId    String?    @map("purchase_id") @db.Uuid
  saleId        String?    @map("sale_id") @db.Uuid
  warrantyStart DateTime?  @map("warranty_start") @db.Date
  warrantyEnd   DateTime?  @map("warranty_end") @db.Date
  status        ImeiStatus @default(AVAILABLE)
  createdAt     DateTime   @default(now()) @map("created_at")

  product  Product   @relation(fields: [productId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
  sale     Sale?     @relation(fields: [saleId], references: [id])

  saleItem   SaleItem?
  repairs    Repair[]
  warranties Warranty[]

  @@map("imei_numbers")
}

// =====================================================================
// Inventory — DDD Chapter 20
// =====================================================================

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  availableQuantity Int      @default(0) @map("available_quantity")
  reorderLevel      Int      @default(0) @map("reorder_level")
  location          String?  @db.VarChar(100)
  updatedAt         DateTime @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId], references: [id])
  transactions InventoryTransaction[]
  adjustments  StockAdjustment[]

  @@map("inventory")
}

model InventoryTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  inventoryId     String                   @map("inventory_id") @db.Uuid
  productId       String                   @map("product_id") @db.Uuid
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Int
  referenceNumber String?                  @map("reference_number") @db.VarChar(100)
  remarks         String?
  createdById     String?                  @map("created_by") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  createdBy User?     @relation("InventoryTransactionCreatedBy", fields: [createdById], references: [id])

  @@index([transactionType, createdAt])
  @@map("inventory_transactions")
}

model StockAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  inventoryId      String   @map("inventory_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  adjustmentReason String   @map("adjustment_reason")
  adjustedById     String?  @map("adjusted_by") @db.Uuid
  adjustedAt       DateTime @default(now()) @map("adjusted_at")

  inventory  Inventory @relation(fields: [inventoryId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  adjustedBy User?     @relation("StockAdjustmentAdjustedBy", fields: [adjustedById], references: [id])

  @@map("stock_adjustments")
}

// =====================================================================
// Customer Management — DDD Chapter 21
// =====================================================================

model Customer {
  id                 String       @id @default(uuid()) @db.Uuid
  customerCode       String       @unique @map("customer_code") @db.VarChar(30)
  firstName          String       @map("first_name") @db.VarChar(100)
  lastName           String?      @map("last_name") @db.VarChar(100)
  phone              String?      @unique @db.VarChar(20)
  email              String?      @db.VarChar(255)
  address            String?
  city               String?      @db.VarChar(100)
  customerType       CustomerType @default(REGULAR) @map("customer_type")
  creditLimit        Decimal      @default(0) @map("credit_limit") @db.Decimal(12, 2)
  outstandingBalance Decimal      @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  notes              String?
  isActive           Boolean      @default(true) @map("is_active")
  // Not in DDD Table 16 — API Spec Chapter 52's "Customer Attachment" upload
  // type (e.g. a scanned ID) needs a field to hold the resulting URL.
  attachmentUrl      String?      @map("attachment_url")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  sales        Sale[]
  salesReturns SalesReturn[]
  repairs      Repair[]
  warranties   Warranty[]

  @@map("customers")
}

// =====================================================================
// Supplier Management — DDD Chapter 22
// =====================================================================

model Supplier {
  id                 String   @id @default(uuid()) @db.Uuid
  supplierCode       String   @unique @map("supplier_code") @db.VarChar(30)
  supplierName       String   @map("supplier_name") @db.VarChar(200)
  contactPerson      String?  @map("contact_person") @db.VarChar(150)
  phone              String?  @db.VarChar(20)
  email              String?  @db.VarChar(255)
  address            String?
  taxNumber          String?  @map("tax_number") @db.VarChar(100)
  paymentTerms       String?  @map("payment_terms") @db.VarChar(100)
  outstandingBalance Decimal  @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@index([supplierName])
  @@map("suppliers")
}

// =====================================================================
// Purchase — DDD Chapter 23
// =====================================================================

model Purchase {
  id             String                @id @default(uuid()) @db.Uuid
  purchaseNumber String                @unique @map("purchase_number") @db.VarChar(50)
  supplierId     String                @map("supplier_id") @db.Uuid
  purchaseDate   DateTime              @map("purchase_date") @db.Date
  subtotal       Decimal               @default(0) @db.Decimal(12, 2)
  discount       Decimal               @default(0) @db.Decimal(12, 2)
  tax            Decimal               @default(0) @db.Decimal(12, 2)
  shippingCost   Decimal               @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  totalAmount    Decimal               @map("total_amount") @db.Decimal(12, 2)
  paymentStatus  PurchasePaymentStatus @default(PENDING) @map("payment_status")
  remarks        String?
  createdById    String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User?    @relation("PurchaseCreatedBy", fields: [createdById], references: [id])

  items       PurchaseItem[]
  returns     PurchaseReturn[]
  imeiNumbers ImeiNumber[]

  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id            String  @id @default(uuid()) @db.Uuid
  purchaseId    String  @map("purchase_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  quantity      Int
  purchasePrice Decimal @map("purchase_price") @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  tax           Decimal @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReturn {
  id           String   @id @default(uuid()) @db.Uuid
  purchaseId   String   @map("purchase_id") @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  returnDate   DateTime @map("return_date") @db.Date
  returnAmount Decimal  @map("return_amount") @db.Decimal(12, 2)
  reason       String?
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  purchase  Purchase             @relation(fields: [purchaseId], references: [id])
  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  createdBy User?                @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  items     PurchaseReturnItem[]

  @@map("purchase_returns")
}

/// Not in DDD Table 20 — purchase_returns is a single row with one aggregate
/// return_amount, but the API Spec's Create Purchase Return body (Chapter
/// 33.2) sends a per-product items array, and reversing inventory correctly
/// requires knowing exactly which product/quantity was returned. Added the
/// same way Sale/SaleItem itemizes a Sale.
model PurchaseReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseReturnId String  @map("purchase_return_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  quantity         Int
  reason           String?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@map("purchase_return_items")
}

// =====================================================================
// Sales — DDD Chapter 24
// =====================================================================

model Sale {
  id            String            @id @default(uuid()) @db.Uuid
  invoiceNumber String            @unique @map("invoice_number") @db.VarChar(50)
  customerId    String?           @map("customer_id") @db.Uuid
  saleDate      DateTime          @map("sale_date") @db.Date
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal           @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount     Decimal           @default(0) @map("due_amount") @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID) @map("payment_status")
  cashierId     String?           @map("cashier_id") @db.Uuid
  remarks       String?
  // Not in DDD Table 21 — the API Spec's "Cancel Sale" (Chapter 34.4, rules:
  // "Restore inventory, Reverse payment, Maintain cancellation history")
  // needs a cancelled state distinct from payment_status, which the DDD has
  // no field for.
  isCancelled   Boolean           @default(false) @map("is_cancelled")
  cancelledAt   DateTime?         @map("cancelled_at")
  cancelReason  String?           @map("cancel_reason")
  createdAt     DateTime          @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  cashier  User?     @relation("SaleCashier", fields: [cashierId], references: [id])

  items       SaleItem[]
  returns     SalesReturn[]
  imeiNumbers ImeiNumber[]
  warranties  Warranty[]

  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @map("sale_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  imeiId       String? @unique @map("imei_id") @db.Uuid
  quantity     Int     @default(1)
  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)

  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  imeiNumber ImeiNumber? @relation(fields: [imeiId], references: [id])

  warranty Warranty?

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalesReturn {
  id           String   @id @default(uuid()) @db.Uuid
  saleId       String   @map("sale_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  returnDate   DateTime @map("return_date") @db.Date
  refundAmount Decimal  @map("refund_amount") @db.Decimal(12, 2)
  returnReason String?  @map("return_reason")
  approvedById String?  @map("approved_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  sale       Sale              @relation(fields: [saleId], references: [id])
  customer   Customer?         @relation(fields: [customerId], references: [id])
  approvedBy User?             @relation("SalesReturnApprovedBy", fields: [approvedById], references: [id])
  items      SalesReturnItem[]

  @@map("sales_returns")
}

/// Not in DDD Table 23 — same deviation as PurchaseReturnItem above, mirrored
/// for the customer-facing side (API Spec Chapter 35.2's items array).
model SalesReturnItem {
  id            String  @id @default(uuid()) @db.Uuid
  salesReturnId String  @map("sales_return_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  quantity      Int
  reason        String?

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@map("sales_return_items")
}

// =====================================================================
// Payments — DDD Chapter 25
// =====================================================================

/// `referenceId` is a polymorphic pointer to either a Sale or a Purchase
/// (selected by `paymentType`) as specified in the DDD — intentionally
/// not a Prisma relation/FK since it targets two different tables.
model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  paymentType          PaymentType   @map("payment_type")
  referenceId          String        @map("reference_id") @db.Uuid
  paymentMethod        PaymentMethod @map("payment_method")
  paymentDate          DateTime      @map("payment_date") @db.Date
  amount               Decimal       @db.Decimal(12, 2)
  transactionReference String?       @map("transaction_reference") @db.VarChar(100)
  notes                String?
  receivedById         String?       @map("received_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")

  receivedBy User? @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([paymentDate, paymentMethod])
  @@map("payments")
}

// =====================================================================
// Cash Drawer — DDD Chapter 26
// =====================================================================

model CashDrawer {
  id              String           @id @default(uuid()) @db.Uuid
  cashierId       String           @map("cashier_id") @db.Uuid
  openingBalance  Decimal          @default(0) @map("opening_balance") @db.Decimal(12, 2)
  closingBalance  Decimal?         @map("closing_balance") @db.Decimal(12, 2)
  expectedBalance Decimal?         @map("expected_balance") @db.Decimal(12, 2)
  difference      Decimal?         @db.Decimal(12, 2)
  openedAt        DateTime         @default(now()) @map("opened_at")
  closedAt        DateTime?        @map("closed_at")
  status          CashDrawerStatus @default(OPEN)

  cashier      User                    @relation("CashDrawerCashier", fields: [cashierId], references: [id])
  transactions CashDrawerTransaction[]

  @@index([cashierId, status])
  @@map("cash_drawers")
}

model CashDrawerTransaction {
  id              String                    @id @default(uuid()) @db.Uuid
  cashDrawerId    String                    @map("cash_drawer_id") @db.Uuid
  transactionType CashDrawerTransactionType @map("transaction_type")
  amount          Decimal                   @db.Decimal(12, 2)
  referenceNumber String?                   @map("reference_number") @db.VarChar(100)
  remarks         String?
  createdAt       DateTime                  @default(now()) @map("created_at")

  cashDrawer CashDrawer @relation(fields: [cashDrawerId], references: [id], onDelete: Cascade)

  @@map("cash_drawer_transactions")
}

// =====================================================================
// Repair Management — DDD Chapter 27
// =====================================================================

model Repair {
  id                   String       @id @default(uuid()) @db.Uuid
  repairTicketNumber   String       @unique @map("repair_ticket_number") @db.VarChar(50)
  customerId           String       @map("customer_id") @db.Uuid
  productId            String?      @map("product_id") @db.Uuid
  imeiId               String?      @map("imei_id") @db.Uuid
  technicianId         String?      @map("technician_id") @db.Uuid
  problemDescription   String       @map("problem_description")
  diagnosis            String?
  estimatedCost        Decimal      @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  actualCost           Decimal      @default(0) @map("actual_cost") @db.Decimal(12, 2)
  repairStatus         RepairStatus @default(RECEIVED) @map("repair_status")
  receivedDate         DateTime     @default(now()) @map("received_date")
  expectedDeliveryDate DateTime?    @map("expected_delivery_date") @db.Date
  deliveredDate        DateTime?    @map("delivered_date")
  remarks              String?
  // Not in DDD Table 27 — API Spec Chapter 52's "Repair Image" upload type
  // (e.g. device condition at intake) needs a field to hold the URL.
  imageUrl             String?      @map("image_url")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  customer   Customer    @relation(fields: [customerId], references: [id])
  product    Product?    @relation(fields: [productId], references: [id])
  imeiNumber ImeiNumber? @relation(fields: [imeiId], references: [id])
  technician Employee?   @relation(fields: [technicianId], references: [id])

  items RepairItem[]

  @@map("repairs")
}

model RepairItem {
  id         String  @id @default(uuid()) @db.Uuid
  repairId   String  @map("repair_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  repair  Repair  @relation(fields: [repairId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("repair_items")
}

// =====================================================================
// Warranty — DDD Chapter 28
// =====================================================================

model Warranty {
  id                   String         @id @default(uuid()) @db.Uuid
  saleId               String         @map("sale_id") @db.Uuid
  saleItemId           String         @unique @map("sale_item_id") @db.Uuid
  customerId           String         @map("customer_id") @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  imeiId               String?        @map("imei_id") @db.Uuid
  warrantyType         String         @map("warranty_type") @db.VarChar(50)
  warrantyPeriodMonths Int            @map("warranty_period_months")
  startDate            DateTime       @map("start_date") @db.Date
  expiryDate           DateTime       @map("expiry_date") @db.Date
  warrantyStatus       WarrantyStatus @default(ACTIVE) @map("warranty_status")
  remarks              String?
  createdAt            DateTime       @default(now()) @map("created_at")

  sale       Sale        @relation(fields: [saleId], references: [id])
  saleItem   SaleItem    @relation(fields: [saleItemId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  imeiNumber ImeiNumber? @relation(fields: [imeiId], references: [id])

  @@map("warranties")
}

// =====================================================================
// Expense Management — DDD Chapter 29
// =====================================================================

model ExpenseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  categoryName String   @unique @map("category_name") @db.VarChar(100)
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  expenseNumber     String        @unique @map("expense_number") @db.VarChar(50)
  expenseCategoryId String        @map("expense_category_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod @map("payment_method")
  expenseDate       DateTime      @map("expense_date") @db.Date
  recordedById      String?       @map("recorded_by") @db.Uuid
  description       String?
  attachmentUrl     String?       @map("attachment_url")
  createdAt         DateTime      @default(now()) @map("created_at")

  category   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  recordedBy Employee?       @relation(fields: [recordedById], references: [id])

  @@map("expenses")
}

// =====================================================================
// Notifications — DDD Chapter 30
// =====================================================================

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  title            String           @db.VarChar(200)
  message          String
  notificationType NotificationType @map("notification_type")
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// =====================================================================
// Audit Logs — DDD Chapter 31
// =====================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([module, action])
  @@map("audit_logs")
}

// =====================================================================
// Settings — DDD Chapter 32
// =====================================================================

model Setting {
  id           String   @id @default(uuid()) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(150)
  settingValue String?  @map("setting_value")
  description  String?
  updatedById  String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("settings")
}
