# Copy this file to .env and fill in real values.
# See req/POS Doc.docx — Volume 4 (SAD/TDD), Chapter 44 — Environment Configuration.

# Prisma CLI datasource (migrate/generate). Two ways to fill these in:
#
# A) A real local PostgreSQL install (e.g. the official Windows installer +
#    pgAdmin), with a database already created — DATABASE_URL and
#    DIRECT_DATABASE_URL are the SAME value, a plain connection string:
#      DATABASE_URL="postgresql://postgres:<password>@localhost:5432/posdb"
#      DIRECT_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/posdb"
#
# B) Prisma's local dev-proxy (`npx prisma dev`, no local Postgres install
#    needed) — DATABASE_URL is the proxy URL it prints on startup,
#    DIRECT_DATABASE_URL is the direct TCP URL it also prints:
#      DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."
#      DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1"
#
# In production both are your real PostgreSQL connection string, same as (A).
# DIRECT_DATABASE_URL is what the app's own Prisma Client uses at runtime
# (via @prisma/adapter-pg); DATABASE_URL is only used by the Prisma CLI.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# --- Application configuration ---
NODE_ENV="development"
PORT=4000

# JWT Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# CORS — comma-separated list of allowed origins (frontend URL)
CORS_ORIGIN="http://localhost:3000"

# Logging — fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Cloudinary (product images, employee photos, attachments)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP (password reset emails). Without this set, reset links are logged to
# the server console instead of emailed — the app still works, just not the
# actual delivery. For Gmail: host smtp.gmail.com, port 587, SMTP_USER is
# your full Gmail address, SMTP_PASS is a 16-character App Password
# (myaccount.google.com/apppasswords — requires 2-Step Verification to be
# on; a regular account password will NOT work here).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
