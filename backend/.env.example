# Copy this file to .env and fill in real values.
# See req/POS Doc.docx — Volume 4 (SAD/TDD), Chapter 44 — Environment Configuration.

# Prisma CLI datasource (migrate/generate). For a local `prisma dev` instance
# this is the proxy URL it prints on startup; in production this is your
# real PostgreSQL connection string.
DATABASE_URL=""

# Direct TCP connection used by the app's own Prisma Client at runtime
# (via @prisma/adapter-pg). Same value as DATABASE_URL in production; only
# differs from it for a local `prisma dev` proxy instance.
DIRECT_DATABASE_URL=""

# --- Application configuration ---
NODE_ENV="development"
PORT=4000

# JWT Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# CORS — comma-separated list of allowed origins (frontend URL)
CORS_ORIGIN="http://localhost:3000"

# Logging — fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Cloudinary (product images, employee photos, attachments)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
